# Firebase credentials — never commit these
GoogleService-Info.plist
serviceAccountKey.json
*.pem
*.p8
*.p12

# Xcode build artifacts
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcscmblueprint

# CocoaPods — keep Podfile.lock, ignore the rest
Pods/
!Podfile.lock

# macOS
.DS_Store

# Xcode user-specific files
*.moved-aside
*.pbxuser
*.perspectivev3
!default.pbxuser
!default.perspectivev3

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Secrets — never commit
.env
**/.env
.env.*
**/.env.*
!**/.env.example
.secrets/
functions/.secret.local
.firebase/

# Local-only build output (never commit)
ios/.build/
ios/DerivedData/
supabase/.temp/
backend/node_modules/
backend/**/node_modules/
backend/.venv/
backend/**/.venv/
.DS_Store
