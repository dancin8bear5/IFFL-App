# Firebase credentials — never commit these
GoogleService-Info.plist
serviceAccountKey.json
*.pem
*.p8
*.p12

# Xcode build artifacts
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcscmblueprint

# CocoaPods — keep Podfile.lock, ignore the rest
Pods/
!Podfile.lock

# macOS
.DS_Store

# Xcode user-specific files
*.moved-aside
*.pbxuser
*.perspectivev3
!default.pbxuser
!default.perspectivev3

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Secrets — never commit
.env
**/.env
.env.*
**/.env.*
!**/.env.example
.secrets/
functions/.secret.local
.firebase/

# Local-only working trees that live on the archive branch, not here.
# ios/ is a second native app (separate from the CodeRed target) and
# backend/ is a parallel Supabase stack; both are archived on
# archive/taylor-pro-2-local. Their build output is enormous — ios/build
# alone is 600MB — so it stays out of every branch.
ios/
backend/
supabase/.temp/
CodeRed.xcodeproj/project.xcworkspace/xcshareddata/

# Firebase CLI debug output
firebase-debug.log
firebase-debug.*.log
out/

# Firestore snapshots — contain member emails and UIDs (config/league).
# This repo is PUBLIC; these must never be committed. See data/README.md.
data/backup/

# Big Board exports — the commissioner's private keep/drop calls on other
# people's rosters. Its Firestore rule is commissioner-only for READ as well
# as write; this repo is PUBLIC, so a backup belongs on the NAS with the
# Firestore snapshots (see data/README.md), never here.
data/big-board-*.csv
