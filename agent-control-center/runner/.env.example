# Agent Control Center — runner env. Copy to runner/.env (gitignored) OR export
# these in the DSM Task Scheduler entry. secrets in job configs are NAMES that
# resolve to these env vars — never put secret values in the job JSON.

# --- Anthropic API (nas-python runner) --------------------------------------
# Your existing Anthropic key (per decision). Leave blank to force dry-run.
ANTHROPIC_API_KEY=
# Model the nas-python runner uses when a job doesn't specify task.model.
# Use a model your API key can access.
ACC_MODEL=claude-opus-4-8

# --- Store / dashboard (defaults are fine) -----------------------------------
# Absolute path is safest on the NAS, e.g. /volume1/acc/store/acc.sqlite
# ACC_DB_PATH=/volume1/agent-control-center/store/acc.sqlite
ACC_HOST=0.0.0.0
ACC_PORT=8787

# Force canned output (no API calls) to test plumbing without a key:
# ACC_DRY_RUN=1
