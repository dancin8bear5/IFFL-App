<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.iffl.espn-weekly</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/jaredtaylor/claude-agents/iffl-web-app/ops/espn-weekly.sh</string>
    </array>
    <!-- Tuesdays at 08:00 local (CT). Monday night is final by then. If the Mac
         is asleep at 08:00, launchd runs it on wake. RunAtLoad false so
         installing doesn't fire a run. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key><integer>2</integer>
        <key>Hour</key><integer>8</integer>
        <key>Minute</key><integer>0</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/jaredtaylor/claude-agents/iffl-web-app/out/espn-weekly.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jaredtaylor/claude-agents/iffl-web-app/out/espn-weekly.stderr.log</string>
</dict>
</plist>
