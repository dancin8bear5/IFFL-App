<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.iffl.espn-weekly</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/jaredtaylor/claude-agents/iffl-web-app/ops/espn-weekly.sh</string>
    </array>
    <!-- Monday nights at 11:30pm, Mac local time (moved from Tuesday 08:00 on
         Nov 25, 2026). If the game is still on, the job waits 30 minutes
         and tries again, up to six times. If the Mac is asleep at 11:30pm,
         launchd runs it on wake. RunAtLoad false so installing doesn't
         fire a run. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key><integer>1</integer>
        <key>Hour</key><integer>23</integer>
        <key>Minute</key><integer>30</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/jaredtaylor/claude-agents/iffl-web-app/out/espn-weekly.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jaredtaylor/claude-agents/iffl-web-app/out/espn-weekly.stderr.log</string>
</dict>
</plist>
