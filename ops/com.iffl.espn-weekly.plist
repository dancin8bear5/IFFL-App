<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.iffl.espn-weekly</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/jaredtaylor/claude-agents/iffl-web-app/ops/espn-weekly.sh</string>
        <string>--scheduled</string>
    </array>
    <!-- launchd does NOT decide when the score job runs (Nov 25, 2026). It
         only knocks: every 5 minutes, at :59 of every hour, and at login.
         ops/graph/due.mjs answers — a week is owed from Monday 11:59pm
         CENTRAL until it is done. That is what survives a Mac that was
         powered off at the slot (launchd never makes that up; it skipped
         week 11) and a Mac in another time zone (launchd keeps the zone it
         booted in). A knock with nothing owed exits in under a second and
         writes nothing. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Minute</key><integer>59</integer>
    </dict>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/jaredtaylor/claude-agents/iffl-web-app/out/espn-weekly.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jaredtaylor/claude-agents/iffl-web-app/out/espn-weekly.stderr.log</string>
</dict>
</plist>
