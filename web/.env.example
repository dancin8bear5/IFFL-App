# Secrets are NOT here. Master: ~/claude-agents/_shared/estate/secrets.env
# This .env is managed by `estate link` — see _shared/estate/README.md
# Key names below are kept deliberately: they document what this project
# needs. `estate link` replaced them with the two lines above on Sep 8.

# Firebase web config — IFFL Auth project (iffl-auth)
# Get these values: Firebase Console → Project Settings → General → "Your apps"
# → Add app → Web (</>) → copy the config values shown.
# Copy this file to `.env` and fill in. NEVER commit .env to git.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=iffl-auth.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=iffl-auth
VITE_FIREBASE_MESSAGING_SENDER_ID=876749980452
VITE_FIREBASE_APP_ID=
